# ---------------------------------------------------------------------------
# Archaeologist — environment configuration
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Hindsight memory service (required) -----------------------------------
# Hindsight Cloud: sign up at https://ui.hindsight.vectorize.io/signup
#   HINDSIGHT_BASE_URL=https://<your-cloud-endpoint>
# Self-hosted Docker (see README "Option B"):
#   HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BASE_URL=http://localhost:8888

# Bearer token for Hindsight. Required for Cloud; usually blank for local Docker.
HINDSIGHT_API_KEY=

# Memory bank that stores all engineering decisions. One bank == one codebase.
HINDSIGHT_BANK_ID=archaeologist

# Seconds before a Hindsight request is abandoned.
HINDSIGHT_TIMEOUT_SECONDS=60

# Retrieval depth for RECALL: low | mid | high
HINDSIGHT_RECALL_BUDGET=high

# Max tokens of recalled fact text used to ground an answer.
HINDSIGHT_RECALL_MAX_TOKENS=4096

# --- LLM provider (required) -----------------------------------------------
# Any OpenAI-compatible endpoint. Defaults target Groq.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1

# --- Application -----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
